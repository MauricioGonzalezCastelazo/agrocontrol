{
  "name": "agrocontrol-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:online": "playwright test -c playwright.online.config.ts",
    "test:local": "playwright test -c playwright.local.config.ts",
    "format:check": "prettier --check src *.ts *.js *.json e2e production-e2e online-e2e local-e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "decimal.js": "10.6.0",
    "dexie": "4.4.6",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  }
}
