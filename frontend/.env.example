VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ORGANIZATION_ID=
# Vista previa de desarrollo, sin datos ni acceso a endpoints privados.
VITE_ENABLE_PREVIEW=true
# Espacio local persistente en IndexedDB, solo en desarrollo y en loopback.
# No usa Supabase ni envía los datos al servidor. main.py lo activa al arrancar.
VITE_ENABLE_LOCAL_WORKSPACE=false
