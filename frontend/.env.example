VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ORGANIZATION_ID=
# Vista previa de desarrollo, sin datos ni acceso a endpoints privados.
VITE_ENABLE_PREVIEW=true
# Espacio local SQLite mediante FastAPI, solo en desarrollo y en loopback.
# main.py coordina ambos procesos y autoriza el navegador. No requiere Supabase.
VITE_ENABLE_LOCAL_WORKSPACE=false
VITE_LOCAL_API_URL=http://127.0.0.1:8000/api/v1
