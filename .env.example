# Solo desarrollo local. Sustituir antes de arrancar Compose.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://agrocontrol:replace-with-a-local-password@localhost:5432/agrocontrol
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=authenticated
# Almacenamiento privado local; nunca dentro de frontend/public.
PRIVATE_FILES_PATH=.local/private-files
MAX_ATTACHMENT_BYTES=26214400
MAX_ORDER_ATTACHMENT_BYTES=104857600
MAX_ATTACHMENTS=20
# El frontend solo recibe valores públicos; nunca service_role ni JWT secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ORGANIZATION_ID=
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENABLE_PREVIEW=true
